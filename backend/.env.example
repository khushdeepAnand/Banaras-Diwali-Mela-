PORT=3001
NODE_ENV=development
# Only explicitly opted-in LOCAL DEMO (memory resets whenever backend restarts).
DEMO_MODE=false
# Explicit disposable public staging only; requires production + DEMO_MODE=true,
# no Supabase URL/key and a private ADMIN_API_TOKEN. Defaults preserve production gates.
STAGING_DEMO=false
# Opt in to serving the built frontend/dist alongside API/WS on the same origin.
SERVE_FRONTEND=false
# Number of trusted reverse-proxy hops. Keep 0 unless direct access is blocked
# and the proxy overwrites X-Forwarded-For; see docs/phase12/STAGING.md.
TRUST_PROXY_HOPS=0
# Exact browser origins for the room WebSocket. Production requires HTTPS origins.
REALTIME_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Room-only celebration: 2-4 distinct session visitors, bounded 1000-120000 ms.
GROUP_DIYA_THRESHOLD=3
GROUP_DIYA_WINDOW_MS=30000
# Select EXISTING project "Diwali mela". Inspect migration state first.
# Apply 001 only if absent, then 002. Never rerun 001 after 002.
SUPABASE_URL=
# Preferred server-only key (sb_secret_...), sent via apikey, not JWT Bearer.
SUPABASE_SECRET_KEY=
# Legacy fallback. Secret key takes precedence if both are identical;
# different non-empty values are rejected. Normally fill ONLY one key name.
SUPABASE_SERVICE_ROLE_KEY=
# Generate a random 32+ byte token (minimum 32 characters); server-only.
ADMIN_API_TOKEN=
# OPTIONAL temporary SQL verification only; NOT a runtime backend requirement.
# Personal management token, never a frontend value. Revoke after release checks.
SUPABASE_ACCESS_TOKEN=
